{
  "archinstall-language": "English",

  "bootloader_config": {
    "bootloader": "Grub",
    "removable": true,
    "uki": false
  },

  "hostname": "@@HOSTNAME@@",

  "kernels": ["@@KERNEL@@"],

  "locale_config": {
    "kb_layout": "uk",
    "sys_enc": "UTF-8",
    "sys_lang": "en_GB.UTF-8"
  },

  "mirror_config": {
    "mirror_regions": {}
  },

  "network_config": { "type": "nm" },

  "ntp": true,

  "profile_config": {
    "profile": {
      "main": "Minimal",
      "details": [],
      "custom_settings": {}
    },
    "gfx_driver": null,
    "greeter": null
  },

  "swap": {
    "enabled": true,
    "algorithm": "zstd"
  },

  "timezone": "Europe/London",

  "packages": [
    "git"
  ],

"custom_commands": [
  "bash -lc 'set -euo pipefail; INSTALLER_DIR=/opt/khione; INSTALLER_SRC=; if [ -d /run/khione-installer ]; then INSTALLER_SRC=/run/khione-installer; elif [ -d /proc/1/root/run/khione-installer ]; then INSTALLER_SRC=/proc/1/root/run/khione-installer; elif [ -d /proc/1/root/root/installer-src ]; then INSTALLER_SRC=/proc/1/root/root/installer-src; fi; if [ -z \"$INSTALLER_SRC\" ]; then echo \"==> ERROR: staged installer not found (build-iso.sh should have staged it under /run/khione-installer) -- aborting instead of fetching an unverified copy from GitHub\" >&2; exit 1; fi; rm -rf \"$INSTALLER_DIR\"; echo \"==> Using local staged installer from $INSTALLER_SRC\"; cp -a \"$INSTALLER_SRC\" \"$INSTALLER_DIR\"; chmod -R a+rX \"$INSTALLER_DIR\" && find \"$INSTALLER_DIR\" -type f -name \"*.sh\" -exec chmod a+x {} \\;'",
  "bash -lc 'set -euo pipefail; echo \"==> Running installer (MODE=@@EDITION@@)\"; env MODE=@@EDITION@@ stdbuf -oL -eL bash /opt/khione/install.sh'"
]
}