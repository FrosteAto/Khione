#!/bin/sh
# Puts the Deepwood wallpaper on every connected screen and workspace that has no
# wallpaper yet, or still has a stock XFCE one. xfdesktop stores wallpapers per output
# name (VGA-1, eDP-1, HDMI-1, ...), which differ per machine, so the skel config
# can't cover them all. Runs at login from /etc/xdg/autostart; a wallpaper the user
# picked is never touched.

IMG=/usr/share/backgrounds/deepwood/deepwood-pines.png
STYLE=5    # zoomed

[ -r "$IMG" ] || exit 0
count=$(xfconf-query -c xfwm4 -p /general/workspace_count 2>/dev/null) || count=5

for out in $(xrandr --query | awk '/ connected/ {print $1}'); do
  ws=0
  while [ "$ws" -lt "$count" ]; do
    base=/backdrop/screen0/monitor$out/workspace$ws
    cur=$(xfconf-query -c xfce4-desktop -p "$base/last-image" 2>/dev/null)
    case $cur in
      '' | /usr/share/backgrounds/xfce/*)
        xfconf-query -c xfce4-desktop -p "$base/last-image" -n -t string -s "$IMG"
        xfconf-query -c xfce4-desktop -p "$base/image-style" -n -t int -s "$STYLE"
        ;;
    esac
    ws=$((ws + 1))
  done
done
