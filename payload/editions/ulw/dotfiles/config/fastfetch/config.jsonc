{
  "$schema": "https://github.com/fastfetch-cli/fastfetch/raw/dev/doc/json_schema.json",

"logo": {
  "type": "file-raw",
  "source": "~/.config/fastfetch/logo.ansi",
    "padding": {
    "top": 2,
    "left": 2
  },
  "color": {
    "1": "#8BB862",
    "2": "#8BB862"
  }
},


  "display": {
    "separator": " 󰑃  "
  },

  "modules": [
    "break",

    {
      "type": "os",
      "key": " DISTRO",
      "keyColor": "#8BB862"
    },
    {
      "type": "kernel",
      "key": "│ ├",
      "keyColor": "#78A88F"
    },
    {
      "type": "packages",
      "key": "│ ├󰏖",
      "keyColor": "#B0D98A"
    },
    {
      "type": "shell",
      "key": "│ └",
      "keyColor": "#A3CFB8"
    },

    {
      "type": "wm",
      "key": " DE/WM",
      "keyColor": "#8BB862"
    },
    {
      "type": "wmtheme",
      "key": "│ ├󰉼",
      "keyColor": "#78A88F"
    },
    {
      "type": "lm",
      "key": "│ ├󰍂",
      "keyColor": "#B0D98A"
    },
    {
      "type": "theme",
      "key": "│ ├󰉼",
      "keyColor": "#A3CFB8"
    },
    {
      "type": "icons",
      "key": "│ ├󰀻",
      "keyColor": "#8BB862"
    },
    {
      "type": "cursor",
      "key": "│ ├󰇀",
      "keyColor": "#78A88F"
    },
    {
      "type": "font",
      "key": "│ ├",
      "keyColor": "#B0D98A"
    },
    {
      "key": "│ └",
      "type": "command",
      "keyColor": "#A87B4A",
      "text": "( fastfetch -s terminal --pipe -l none; fastfetch -s terminalfont --pipe -l none ) | sed 's/WM //g; s/Theme/-/g' | tr '\n' ' ' | sed 's/Terminal//g' | sed 's/Font//g' | sed 's/󰑃//g' | cut -c 4- | tr -s ' '| sed 's/ /, /2'"
    },

    {
      "type": "host",
      "key": "󰌢 SYSTEM",
      "keyColor": "#A87B4A"
    },
    {
      "type": "cpu",
      "key": "│ ├",
      "keyColor": "#8BB862"
    },
    {
      "type": "gpu",
      "key": "│ ├󰢮",
      "format": "{2}",
      "detectionMethod": "vulkan",
      "keyColor": "#78A88F"
    },
    {
      "type": "display",
      "key": "│ ├󰍹",
      "compactType": "original-with-refresh-rate",
      "keyColor": "#B0D98A"
    },
    {
      "type": "memory",
      "key": "│ ├󰾆",
      "keyColor": "#A3CFB8"
    },
    {
      "type": "display",
      "key": "│ └󰍹",
      "keyColor": "#8BB862"
    },

    {
      "type": "sound",
      "key": " AUDIO",
      "format": "{name}",
      "keyColor": "#78A88F"
    },
    {
      "type": "player",
      "key": "│ ├󰥠",
      "keyColor": "#B0D98A"
    },
    {
      "type": "media",
      "key": "│ └󰝚",
      "keyColor": "#C65D4F"
    },

    {
      "type": "custom",
      "format": "\u001b[38;2;139;184;98m\uf111  \u001b[38;2;120;168;143m\uf111  \u001b[38;2;176;217;138m\uf111  \u001b[38;2;163;207;184m\uf111  \u001b[38;2;168;123;74m\uf111  \u001b[38;2;205;165;122m\uf111  \u001b[38;2;198;93;79m\uf111  \u001b[38;2;205;165;122m\uf111  \u001b[38;2;168;123;74m\uf111  \u001b[38;2;163;207;184m\uf111  \u001b[38;2;176;217;138m\uf111  \u001b[38;2;120;168;143m\uf111  \u001b[38;2;139;184;98m\uf111 "
    },

    "break"
  ]
}
