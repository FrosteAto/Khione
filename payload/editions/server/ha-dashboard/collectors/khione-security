#!/bin/bash
set -euo pipefail

out=/var/lib/hass/snapshots/security.json
mkdir -p "$(dirname "$out")"

# fail2ban: sum of "Currently banned" across every configured jail --
# confirmed live against this server's real output format
# ("Jail list:\tcockpit, sshd", "Currently banned:\t0"). Also builds the
# full list of currently-banned IPs per jail (ban_entries) for the
# Security page's detail view, and tracks whether the service is even
# running -- banned_ips alone can't distinguish "healthy and quiet" from
# "the service is down", both of which read as 0.
f2b_banned=0
fail2ban_active=false
ban_entries=()
if command -v fail2ban-client &>/dev/null; then
  systemctl is-active --quiet fail2ban.service && fail2ban_active=true
  jail_list="$(fail2ban-client status 2>/dev/null | sed -n 's/.*Jail list:[[:space:]]*//p')"
  if [[ -n "$jail_list" ]]; then
    IFS=',' read -ra jails <<<"$jail_list"
    for j in "${jails[@]}"; do
      j="$(echo "$j" | xargs)"
      [[ -z "$j" ]] && continue
      jail_status="$(fail2ban-client status "$j" 2>/dev/null || true)"
      count="$(echo "$jail_status" | sed -n 's/.*Currently banned:[[:space:]]*//p')"
      count="${count//[^0-9]/}"
      f2b_banned=$((f2b_banned + ${count:-0}))
      ip_line="$(echo "$jail_status" | sed -n 's/.*Banned IP list:[[:space:]]*//p')"
      if [[ -n "$ip_line" ]]; then
        for ip in $ip_line; do
          ban_entries+=("$j|$ip")
        done
      fi
    done
  fi
fi
ban_list_raw="$(printf '%s\n' "${ban_entries[@]}")"

# CrowdSec: active decisions actually being enforced right now (not the
# size of the downloaded community blocklist, which is much larger and
# isn't itself a sign anything happened on this box). Keeps the raw JSON
# too, for the Security page's full decision log, and tracks service
# health the same way as fail2ban above.
cs_decisions=0
crowdsec_active=false
cs_json="[]"
if command -v cscli &>/dev/null; then
  systemctl is-active --quiet crowdsec.service && crowdsec_active=true
  cs_json="$(cscli decisions list -o json 2>/dev/null || echo '[]')"
  cs_decisions="$(python3 -c "
import json, sys
try:
    d = json.loads(sys.argv[1])
except ValueError:
    d = []
print(len(d) if isinstance(d, list) else 0)
" "$cs_json" 2>/dev/null || echo 0)"
fi

# AIDE: result of its last daily run. AIDE's exit code is a bitmask of
# what kind of change it found (added/removed/modified) -- any nonzero
# value means SOMETHING changed on disk, which fail2ban/CrowdSec (both
# purely network-facing) can't see at all. When something did change,
# also pulls that run's actual diff lines from its journal output (the
# AUR aide package logs to both /var/log/aide.log and the journal) for
# the Security page's detail view.
aide_status="unknown"
aide_last_run=""
aide_diff_raw=""
if systemctl list-unit-files aidecheck.service &>/dev/null; then
  aide_exit="$(systemctl show aidecheck.service -p ExecMainStatus --value 2>/dev/null || true)"
  aide_last_run="$(systemctl show aidecheck.service -p ExecMainExitTimestamp --value 2>/dev/null || true)"
  if [[ -z "$aide_last_run" ]]; then
    aide_status="not_yet_run"
  elif [[ "$aide_exit" == "0" ]]; then
    aide_status="clean"
  else
    aide_status="changes_detected"
    aide_start="$(systemctl show aidecheck.service -p ExecMainStartTimestamp --value 2>/dev/null || true)"
    if [[ -n "$aide_start" ]]; then
      aide_diff_raw="$(journalctl -u aidecheck.service --since="$aide_start" --no-pager -o cat 2>/dev/null | grep -v '^$' | tail -n 60 || true)"
    fi
  fi
fi

# auditd: actually running, and is the ruleset tamper-proofed (immutable
# until reboot -- auditctl -s's "enabled" field: 1 = mutable, 2 =
# immutable, confirmed live)? When active, also pulls a short tail of
# recent events against the extra watch paths (the khione_watch_extra
# key every such rule is tagged with, see configure_auditd) for the
# Security page's detail view.
auditd_active=false
auditd_immutable=false
auditd_recent_raw=""
if command -v auditctl &>/dev/null; then
  systemctl is-active --quiet auditd.service && auditd_active=true
  if auditctl -s 2>/dev/null | grep -q "^enabled 2"; then
    auditd_immutable=true
  fi
  if [[ "$auditd_active" == true ]] && command -v ausearch &>/dev/null; then
    auditd_recent_raw="$(ausearch -k khione_watch_extra --format text 2>/dev/null | tail -n 10 || true)"
  fi
fi

# ufw: count of active numbered rules (both v4 and v6 lines) -- a quick
# "is the firewall actually doing anything" sanity figure, not meant to
# match FIREWALL_RULES exactly (ufw also doubles every rule for IPv6).
ufw_rules=0
if command -v ufw &>/dev/null; then
  ufw_rules="$(ufw status numbered 2>/dev/null | grep -c '^\[' || true)"
fi

# Active logged-in sessions (console/SSH with a real tty) -- `who`, not
# `w`, since it's simpler and this only needs a count.
active_sessions="$(who 2>/dev/null | wc -l)"

# Converted to epoch seconds here, not left as systemd's own timestamp
# text -- confirmed live that format ("Tue 2026-11-17 00:38:34 GMT")
# isn't something JS Date.parse reads correctly, and that `date -d ""`
# on an empty/not-yet-triggered value silently defaults to "now" rather
# than failing, so the empty check has to happen BEFORE the conversion.
aide_next_run=""
if systemctl list-unit-files aidecheck.timer &>/dev/null; then
  raw_next="$(systemctl show aidecheck.timer -p NextElapseUSecRealtime --value 2>/dev/null || true)"
  [[ -n "$raw_next" ]] && aide_next_run="$(date -d "$raw_next" +%s 2>/dev/null || true)"
fi

# Most recent ban fail2ban has ever recorded, regardless of whether it's
# still active -- confirmed live fail2ban keeps this in its own sqlite
# db (bans table: jail, ip, timeofban) even after a ban expires, so
# "currently 0 banned" doesn't have to mean "nothing to report."
last_ban_jail=""
last_ban_time=""
if [[ -r /var/lib/fail2ban/fail2ban.sqlite3 ]] && command -v sqlite3 &>/dev/null; then
  last_ban_row="$(sqlite3 -separator '|' /var/lib/fail2ban/fail2ban.sqlite3 \
    "SELECT jail, timeofban FROM bans ORDER BY timeofban DESC LIMIT 1;" 2>/dev/null || true)"
  if [[ -n "$last_ban_row" ]]; then
    last_ban_jail="${last_ban_row%%|*}"
    last_ban_time="${last_ban_row##*|}"
  fi
fi

# Quad9 DNS and the GRUB password are both one-time installer config,
# not something HA has a sensor for -- confirmed live rather than
# assumed, in case either was ever hand-reverted after install.
quad9_active=false
if grep -q "nameserver 9\.9\.9\.9" /etc/resolv.conf 2>/dev/null; then
  quad9_active=true
fi
grub_locked=false
if [[ -f /etc/grub.d/40_custom ]] && grep -q "^set superusers" /etc/grub.d/40_custom 2>/dev/null; then
  grub_locked=true
fi

# cs_json can be large (a burst of CrowdSec decisions) -- Linux caps a
# single argv element at MAX_ARG_STRLEN (128KB), so it goes through a
# temp file instead of argv to avoid an E2BIG crash under `set -e`.
tmpdir="$(mktemp -d)"
trap 'rm -rf "$tmpdir"' EXIT
printf '%s' "$cs_json" > "$tmpdir/cs.json"

python3 - "$f2b_banned" "$cs_decisions" "$aide_status" "$aide_last_run" "$auditd_active" "$auditd_immutable" \
  "$ufw_rules" "$active_sessions" "$aide_next_run" "$last_ban_jail" "$last_ban_time" "$quad9_active" "$grub_locked" \
  "$fail2ban_active" "$crowdsec_active" "$ban_list_raw" "$tmpdir/cs.json" "$aide_diff_raw" "$auditd_recent_raw" <<'PYEOF' > "$out.tmp"
import json, sys
(f2b_banned, cs_decisions, aide_status, aide_last_run, auditd_active, auditd_immutable,
 ufw_rules, active_sessions, aide_next_run, last_ban_jail, last_ban_time, quad9_active, grub_locked,
 fail2ban_active, crowdsec_active, ban_list_raw, cs_json_path, aide_diff_raw, auditd_recent_raw) = sys.argv[1:20]
with open(cs_json_path) as f:
    cs_json = f.read()

ban_list = [
    {"jail": line.split("|", 1)[0], "ip": line.split("|", 1)[1]}
    for line in ban_list_raw.splitlines() if "|" in line
]

try:
    cs_raw = json.loads(cs_json)
except ValueError:
    cs_raw = []
crowdsec_decision_log = []
for d in (cs_raw if isinstance(cs_raw, list) else []):
    source = d.get("source") or {}
    decisions_list = d.get("decisions") or []
    first_decision = decisions_list[0] if decisions_list else {}
    crowdsec_decision_log.append({
        "ip": source.get("ip") or source.get("value") or first_decision.get("value"),
        "scenario": d.get("scenario"),
        "duration": first_decision.get("duration"),
        "scope": source.get("scope") or first_decision.get("scope"),
    })

aide_diff = [line for line in aide_diff_raw.splitlines() if line.strip()]
auditd_recent = [line for line in auditd_recent_raw.splitlines() if line.strip()]

print(json.dumps({
    "banned_ips": int(f2b_banned),
    "crowdsec_decisions": int(cs_decisions),
    "aide_status": aide_status,
    "aide_last_run": aide_last_run,
    "aide_next_run": int(aide_next_run) if aide_next_run else None,
    "auditd_active": auditd_active == "true",
    "auditd_immutable": auditd_immutable == "true",
    "ufw_rules": int(ufw_rules),
    "active_sessions": int(active_sessions),
    "last_ban_jail": last_ban_jail or None,
    "last_ban_time": int(last_ban_time) if last_ban_time else None,
    "quad9_active": quad9_active == "true",
    "grub_locked": grub_locked == "true",
    "fail2ban_active": fail2ban_active == "true",
    "crowdsec_active": crowdsec_active == "true",
    "ban_list": ban_list,
    "crowdsec_decision_log": crowdsec_decision_log,
    "aide_diff": aide_diff,
    "auditd_recent": auditd_recent,
}))
PYEOF
mv "$out.tmp" "$out"
