#!/bin/bash
set -euo pipefail

out=/var/lib/hass/snapshots/system.json
mkdir -p "$(dirname "$out")"

# checkupdates (pacman-contrib) exits 2 when there are no updates.
updates_list="$(checkupdates 2>/dev/null || true)"
if [[ -n "$updates_list" ]]; then
  updates=$(wc -l <<<"$updates_list")
else
  updates=0
fi

# arch-audit cross-references installed packages against the Arch Security
# Tracker. --upgradable narrows this to vulnerabilities that already have a
# fix available -- a vulnerability with no fix yet has no "update now"
# action, so it's deliberately left out of this count (that's a different
# kind of warning this dashboard doesn't attempt to show). Critical/High
# severity, or any code-execution class regardless of severity score, is
# what the dashboard treats as "big red warning, update now" instead of
# the routine yellow "updates pending" -- arch-audit may not be installed
# on every system this collector runs on, hence the command -v guard.
audit_json="[]"
if command -v arch-audit &>/dev/null; then
  audit_json="$(arch-audit --upgradable --json 2>/dev/null || echo '[]')"
fi

uptime_s=$(cut -d. -f1 /proc/uptime)
days=$((uptime_s / 86400))
hours=$(((uptime_s % 86400) / 3600))
mins=$(((uptime_s % 3600) / 60))

read -r load1 load5 load15 _ < /proc/loadavg

swap_total_kb=$(awk '/^SwapTotal:/{print $2}' /proc/meminfo)
swap_free_kb=$(awk '/^SwapFree:/{print $2}' /proc/meminfo)
swap_used_kb=$((swap_total_kb - swap_free_kb))

python3 - "$updates" "$audit_json" "${days}d ${hours}h ${mins}m" "$(uname -r)" "$load1" "$load5" "$load15" "$swap_used_kb" "$swap_total_kb" <<'PYEOF' > "$out.tmp"
import json
import sys

updates, audit_json, uptime, kernel, load1, load5, load15, swap_used_kb, swap_total_kb = sys.argv[1:10]
entries = json.loads(audit_json) if audit_json else []
urgent = [
    e for e in entries
    if e.get("severity") in ("Critical", "High")
    or "code execution" in e.get("type", "")
    or "command execution" in e.get("type", "")
]
security_detail = [
    {
        "package": ", ".join(e.get("packages", [])),
        "severity": e.get("severity"),
        "type": e.get("type"),
        "cve": (e.get("issues") or [None])[0],
    }
    for e in urgent
]

print(json.dumps({
    "updates": int(updates),
    "security_updates": len(urgent),
    "security_detail": security_detail,
    "uptime": uptime,
    "kernel": kernel,
    "load1": float(load1),
    "load5": float(load5),
    "load15": float(load15),
    "swap_used_gb": int(swap_used_kb) * 1024 / 1e9,
    "swap_total_gb": int(swap_total_kb) * 1024 / 1e9,
}))
PYEOF
mv "$out.tmp" "$out"
