{
  "$schema": "https://github.com/fastfetch-cli/fastfetch/raw/dev/doc/json_schema.json",

  "display": {
    "separator": " 󰑃  "
  },

  "logo": {
    "type": "file-raw",
    "source": "~/.config/fastfetch/logo.ansi",
    "padding": {
      "top": 2,
      "left": 2
    },
    "color": {
      "1": "#39C5BB",
      "2": "#FF6F91"
    }
  },

  "modules": [
    "break",

    {
      "type": "os",
      "key": " DISTRO",
      "keyColor": "#39C5BB"
    },
    {
      "type": "kernel",
      "key": "│ ├",
      "keyColor": "#5CD6D6"
    },
    {
      "type": "packages",
      "key": "│ ├󰏖",
      "keyColor": "#82A5FF"
    },
    {
      "type": "shell",
      "key": "│ └",
      "keyColor": "#FF6F91"
    },

    {
      "type": "wm",
      "key": " DE/WM",
      "keyColor": "#39C5BB"
    },
    {
      "type": "wmtheme",
      "key": "│ ├󰉼",
      "keyColor": "#5CD6D6"
    },
    {
      "type": "lm",
      "key": "│ ├󰍂",
      "keyColor": "#82A5FF"
    },
    {
      "type": "theme",
      "key": "│ ├󰉼",
      "keyColor": "#FF6F91"
    },
    {
      "type": "icons",
      "key": "│ ├󰀻",
      "keyColor": "#39C5BB"
    },
    {
      "type": "cursor",
      "key": "│ ├󰇀",
      "keyColor": "#5CD6D6"
    },
    {
      "type": "font",
      "key": "│ ├",
      "keyColor": "#82A5FF"
    },
    {
      "key": "│ └",
      "type": "command",
      "keyColor": "#FF6F91",
      "text": "( fastfetch -s terminal --pipe -l none; fastfetch -s terminalfont --pipe -l none ) | sed 's/WM //g; s/Theme/-/g' | tr '\n' ' ' | sed 's/Terminal//g' | sed 's/Font//g' | sed 's/󰑃//g' | cut -c 4- | tr -s ' '| sed 's/ /, /2'"
    },

    {
      "type": "host",
      "key": "󰌢 SYSTEM",
      "keyColor": "#FF6F91"
    },
    {
      "type": "cpu",
      "key": "│ ├",
      "keyColor": "#39C5BB"
    },
    {
      "type": "gpu",
      "key": "│ ├﬙",
      "format": "{2}",
      "detectionMethod": "vulkan",
      "keyColor": "#82A5FF"
    },
    {
      "type": "display",
      "key": "│ ├󰍹",
      "compactType": "original-with-refresh-rate",
      "keyColor": "#5CD6D6"
    },
    {
      "type": "memory",
      "key": "│ ├󰾆",
      "keyColor": "#FF6F91"
    },
    {
      "type": "display",
      "key": "│ └󰍹",
      "keyColor": "#39C5BB"
    },

    {
      "type": "sound",
      "key": " AUDIO",
      "format": "{2}",
      "keyColor": "#5CD6D6"
    },
    {
      "type": "player",
      "key": "│ ├󰥠",
      "keyColor": "#82A5FF"
    },
    {
      "type": "media",
      "key": "│ └󰝚",
      "keyColor": "#FF6F91"
    },

    {
      "type": "custom",
      "format": "\u001b[38;2;57;197;187m  \u001b[38;2;92;214;214m  \u001b[38;2;130;165;255m  \u001b[38;2;255;143;163m  \u001b[38;2;255;111;145m  \u001b[38;2;255;143;163m  \u001b[38;2;130;165;255m  \u001b[38;2;92;214;214m  \u001b[38;2;57;197;187m"
    },

    "break"
  ]
}
