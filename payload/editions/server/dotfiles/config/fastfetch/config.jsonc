{
  "$schema": "https://github.com/fastfetch-cli/fastfetch/raw/dev/doc/json_schema.json",

  "display": {
    "separator": " 󰑃  "
  },

  "logo": {
    "type": "file-raw",
    "source": "~/.config/fastfetch/logo.ansi",
    "color": {
      "1": "#55B6EA",
      "2": "#1B3A5C"
    }
  },

  "modules": [
    "break",

    {
      "type": "os",
      "key": " DISTRO",
      "keyColor": "#55B6EA"
    },
    {
      "type": "kernel",
      "key": "│ ├",
      "keyColor": "#6B83C2"
    },
    {
      "type": "packages",
      "key": "│ ├󰏖",
      "keyColor": "#D98A3D"
    },
    {
      "type": "shell",
      "key": "│ └",
      "keyColor": "#33478A"
    },

    {
      "type": "wm",
      "key": " DE/WM",
      "keyColor": "#55B6EA"
    },
    {
      "type": "wmtheme",
      "key": "│ ├󰉼",
      "keyColor": "#6B83C2"
    },
    {
      "type": "lm",
      "key": "│ ├󰍂",
      "keyColor": "#D98A3D"
    },
    {
      "type": "theme",
      "key": "│ ├󰉼",
      "keyColor": "#33478A"
    },
    {
      "type": "icons",
      "key": "│ ├󰀻",
      "keyColor": "#55B6EA"
    },
    {
      "type": "cursor",
      "key": "│ ├󰇀",
      "keyColor": "#6B83C2"
    },
    {
      "type": "font",
      "key": "│ ├",
      "keyColor": "#D98A3D"
    },
    {
      "key": "│ └",
      "type": "command",
      "keyColor": "#33478A",
      "text": "( fastfetch -s terminal --pipe -l none; fastfetch -s terminalfont --pipe -l none ) | sed 's/WM //g; s/Theme/-/g' | tr '\n' ' ' | sed 's/Terminal//g' | sed 's/Font//g' | sed 's/󰑃//g' | cut -c 4- | tr -s ' '| sed 's/ /, /2'"
    },

    {
      "type": "host",
      "key": "󰌢 SYSTEM",
      "keyColor": "#33478A"
    },
    {
      "type": "cpu",
      "key": "│ ├",
      "keyColor": "#55B6EA"
    },
    {
      "type": "gpu",
      "key": "│ ├﬙",
      "format": "{2}",
      "detectionMethod": "vulkan",
      "keyColor": "#D98A3D"
    },
    {
      "type": "display",
      "key": "│ ├󰍹",
      "compactType": "original-with-refresh-rate",
      "keyColor": "#6B83C2"
    },
    {
      "type": "memory",
      "key": "│ ├󰾆",
      "keyColor": "#33478A"
    },
    {
      "type": "display",
      "key": "│ └󰍹",
      "keyColor": "#55B6EA"
    },

    {
      "type": "sound",
      "key": " AUDIO",
      "format": "{2}",
      "keyColor": "#6B83C2"
    },
    {
      "type": "player",
      "key": "│ ├󰥠",
      "keyColor": "#D98A3D"
    },
    {
      "type": "media",
      "key": "│ └󰝚",
      "keyColor": "#33478A"
    },

    {
      "type": "custom",
      "format": "\u001b[38;2;85;182;234m  \u001b[38;2;107;131;194m  \u001b[38;2;217;138;61m  \u001b[38;2;67;90;158m  \u001b[38;2;51;71;138m  \u001b[38;2;67;90;158m  \u001b[38;2;217;138;61m  \u001b[38;2;107;131;194m  \u001b[38;2;85;182;234m"
    },

    "break"
  ]
}
