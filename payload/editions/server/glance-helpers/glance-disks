#!/usr/bin/env python3
"""Write disk usage JSON for the Glance dashboard's Disks widget."""
import json
import os
import shutil

OUT = "/var/lib/glance/assets/disks.json"

disks = []
seen_devices = set()
with open("/proc/mounts") as f:
    for line in f:
        device, mountpoint = line.split()[:2]
        if not device.startswith("/dev/") or device in seen_devices:
            continue
        seen_devices.add(device)
        mountpoint = mountpoint.replace("\\040", " ")
        try:
            usage = shutil.disk_usage(mountpoint)
        except OSError:
            continue
        disks.append({
            "path": mountpoint,
            "used_gb": usage.used / 1e9,
            "total_gb": usage.total / 1e9,
            "percent": round(usage.used / usage.total * 100),
        })

disks.sort(key=lambda d: d["path"])
os.makedirs(os.path.dirname(OUT), exist_ok=True)
tmp = OUT + ".tmp"
with open(tmp, "w") as f:
    json.dump({"disks": disks}, f)
os.replace(tmp, OUT)
