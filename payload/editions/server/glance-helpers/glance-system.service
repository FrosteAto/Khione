[Unit]
Description=Collect system info (pending updates, uptime) for Glance dashboard
Wants=network-online.target
After=network-online.target
# Runs once at boot before Glance so the widget JSON always exists.
Before=glance.service

[Service]
Type=oneshot
User=glance
Group=glance
ExecStart=/usr/local/bin/glance-system

[Install]
WantedBy=multi-user.target
