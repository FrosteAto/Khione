def week_for(day):
    return ((day - WEEK1_MONDAY).days // 7) % 4 + 1


def span_for(day):
    """Return (meals, position_in_span) for a date."""
    day_name = DAY_NAMES[day.weekday()]
    for days, meals in WEEKS[week_for(day)]:
        if day_name in days:
            return meals, days.index(day_name)
    raise KeyError(day_name)


def dinner_status(day):
    """Return (kind, status_label) for a date's dinner."""
    meals, position = span_for(day)
    info = DINNERS[meals["dinner"]]
    if info["fresh"]:
        return "cook", "COOK FRESH TONIGHT"
    if position == 0:
        return "cook", f"COOK NIGHT · MAKES {info['batch']}"
    return "leftovers", f"LEFTOVERS · PORTION {position + 1} OF {info['batch']}"


