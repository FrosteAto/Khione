def write_json(path, data, indent=None):
    os.makedirs(os.path.dirname(path), exist_ok=True)
    tmp = path + ".tmp"
    with open(tmp, "w") as f:
        json.dump(data, f, indent=indent, ensure_ascii=False)
    os.replace(tmp, path)


def ensure_seed_data():
    if not os.path.exists(RECIPES_PATH):
        write_json(RECIPES_PATH, {"recipes": SEED_RECIPES}, indent=2)
    if not os.path.exists(PLAN_PATH):
        write_json(PLAN_PATH, SEED_PLAN, indent=2)


def load_json(path):
    with open(path) as f:
        return json.load(f)


def midpoint(lo, hi):
    return round((lo + hi) / 2)


def macro_detail(r):
    kcal = f"{r['kcal_min']}" if r["kcal_min"] == r["kcal_max"] else f"{r['kcal_min']}–{r['kcal_max']}"
    protein = f"{r['protein_min']}" if r["protein_min"] == r["protein_max"] else f"{r['protein_min']}–{r['protein_max']}"
    return f"~{kcal} kcal · ~{protein}g protein"


ensure_seed_data()
RECIPES = load_json(RECIPES_PATH)["recipes"]
RECIPES_BY_ID = {r["id"]: r for r in RECIPES}
PLAN = load_json(PLAN_PATH)
WEEK1_MONDAY = date.fromisoformat(PLAN["week1_monday"])
TOTAL_WEEKS = len(PLAN["weeks"])


def week_for(day):
    return ((day - WEEK1_MONDAY).days // 7) % TOTAL_WEEKS + 1


def span_for(day):
    """Return (span, position_in_span) for a date."""
    day_name = DAY_NAMES[day.weekday()]
    for span in PLAN["weeks"][str(week_for(day))]:
        if day_name in span["days"]:
            return span, span["days"].index(day_name)
    raise KeyError(day_name)


def day_span(week_num, day_name):
    for span in PLAN["weeks"][str(week_num)]:
        if day_name in span["days"]:
            return span
    raise KeyError(day_name)


def slot_names(ids):
    return " + ".join(RECIPES_BY_ID[i]["name"] for i in ids)


def slot_macros(ids):
    kcal = sum(midpoint(RECIPES_BY_ID[i]["kcal_min"], RECIPES_BY_ID[i]["kcal_max"]) for i in ids)
    protein = sum(midpoint(RECIPES_BY_ID[i]["protein_min"], RECIPES_BY_ID[i]["protein_max"]) for i in ids)
    return kcal, protein


def dinner_status(day):
    """Return (kind, status_label) for a date's dinner."""
    span, position = span_for(day)
    info = RECIPES_BY_ID[span["dinner"][0]]
    if info["fresh"]:
        return "cook", "COOK FRESH TONIGHT"
    if position == 0:
        return "cook", f"COOK NIGHT · MAKES {info['batch']}"
    return "leftovers", f"LEFTOVERS · PORTION {position + 1} OF {info['batch']}"


today = date.today()
week = week_for(today)
day_idx = today.weekday()
today_span, _ = span_for(today)

kcal = sum(slot_macros(today_span[slot])[0] for slot in SLOTS)
protein = sum(slot_macros(today_span[slot])[1] for slot in SLOTS)

dinner_recipe = RECIPES_BY_ID[today_span["dinner"][0]]
kind, status = dinner_status(today)

tomorrow = today + timedelta(days=1)
tomorrow_span, _ = span_for(tomorrow)
tomorrow_kind, _ = dinner_status(tomorrow)
tomorrow_recipe = RECIPES_BY_ID[tomorrow_span["dinner"][0]]
tomorrow_label = f"{tomorrow_recipe['name']} ({'cooking' if tomorrow_kind == 'cook' else 'leftovers'})"


def week_view(target_week):
    """Day table + shopping lists for an arbitrary week — the shared shape
    behind both meals.json's (always-current) week and meals-preview.json's
    (browsable) week. is_today only lights up when target_week is actually
    the real current week; otherwise nothing in the previewed table should
    look like "today"."""
    is_current = target_week == week
    return {
        "week": target_week,
        "total_weeks": TOTAL_WEEKS,
        "actual_current_week": week,
        "is_current": is_current,
        "next_week": target_week % TOTAL_WEEKS + 1,
        "prev_week": (target_week - 2) % TOTAL_WEEKS + 1,
        "days": [{"name": name,
                  "is_today": is_current and i == day_idx,
                  **{slot: slot_names(day_span(target_week, name)[slot]) for slot in SLOTS}}
                 for i, name in enumerate(DAY_NAMES)],
        **{f"shopping_{section}": [{"t": item} for item in items]
           for section, items in PLAN["shopping"][str(target_week)].items()},
    }


requested_week = None
if len(sys.argv) >= 3 and sys.argv[1] == "--preview":
    try:
        requested_week = ((int(sys.argv[2]) - 1) % TOTAL_WEEKS) + 1
    except ValueError:
        requested_week = None

data = {
    "day_name": today.strftime("%A"),
    "today": {slot: slot_names(today_span[slot]) for slot in SLOTS},
    "kcal": kcal,
    "kcal_percent": min(100, round(kcal / 1800 * 100)),
    "protein": protein,
    "protein_percent": min(100, round(protein / 120 * 100)),
    "tonight": {
        "name": dinner_recipe["name"],
        "kind": kind,
        "status": status,
        "detail": macro_detail(dinner_recipe),
        "ingredients": dinner_recipe["ingredients"],
        "instructions": dinner_recipe["instructions"],
        "tomorrow": tomorrow_label,
    },
    **week_view(week),
}

write_json(PREVIEW_OUT, week_view(week if requested_week is None else requested_week))

for key, meal_type in (("recipes_breakfast", "breakfast"), ("recipes_lunch", "lunch"),
                        ("recipes_snacks", "snack"), ("recipes_dinner", "dinner")):
    data[key] = [{
        "id": r["id"], "name": r["name"],
        "kcal_min": r["kcal_min"], "kcal_max": r["kcal_max"],
        "protein_min": r["protein_min"], "protein_max": r["protein_max"],
        "detail": macro_detail(r),
        "ingredients": r["ingredients"], "instructions": r["instructions"],
        "batch": r["batch"], "fresh": r["fresh"],
    } for r in RECIPES if r["meal_type"] == meal_type]

