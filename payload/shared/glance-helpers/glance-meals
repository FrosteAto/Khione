today_meals, _ = span_for(today)

kcal = sum(MACROS[m][0] for m in today_meals.values())
protein = sum(MACROS[m][1] for m in today_meals.values())

tonight_info = DINNERS[today_meals["dinner"]]
kind, status = dinner_status(today)

tomorrow = today + timedelta(days=1)
tomorrow_meals, _ = span_for(tomorrow)
tomorrow_kind, _ = dinner_status(tomorrow)
tomorrow_label = f"{tomorrow_meals['dinner']} ({'cooking' if tomorrow_kind == 'cook' else 'leftovers'})"


def day_meals(week_num, day_name):
    for days, meals in WEEKS[week_num]:
        if day_name in days:
            return meals
    raise KeyError(day_name)


