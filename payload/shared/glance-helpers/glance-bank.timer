[Unit]
Description=Sync bank spending for Glance 4x a day (GoCardless free-tier rate limit)

[Timer]
# No OnBootSec: the service itself runs at boot (Before=glance.service),
# and OnUnitActiveSec chains from that, avoiding a wasted double sync.
OnUnitActiveSec=6h
RandomizedDelaySec=15min

[Install]
WantedBy=timers.target
