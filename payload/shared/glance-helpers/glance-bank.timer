[Unit]
Description=Hourly glance-bank tick (real API sync ~every 6h, gated in the script)

[Timer]
# No OnBootSec: the service itself runs at boot (Before=glance.service).
# Hourly ticks normally just rebuild the JSON from the cache; glance-bank
# only hits the API when the last successful sync is ~6h old, so a failed
# sync gets retried within the hour without blowing the daily quota.
OnUnitActiveSec=1h
RandomizedDelaySec=10min

[Install]
WantedBy=timers.target
