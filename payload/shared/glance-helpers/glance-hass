#!/usr/bin/env python3
"""Poll Home Assistant and write hass.json for the Glance dashboard's
Smart Home page: every group entity (light/switch/group domains) with its
on/off state and summed member power draw, plus every power sensor.

The timer runs this every minute; the :8081 helper also runs it straight
after a toggle so the redirect lands on fresh state. Group power is
matched heuristically: a member like switch.desk_plug picks up power
sensors whose ids start with desk_plug (e.g. sensor.desk_plug_power) —
the standard ZHA/Z2M smart-plug naming.

HASS_TOKEN is a long-lived access token from the HA profile's Security
tab, saved via the dashboard's Admin page (or by hand). The env file is
read directly on every run — not just via the systemd unit — so a token
saved seconds ago works without any service restarts.
"""
import json
import os
import sys
import urllib.request
from datetime import datetime

OUT = "/var/lib/glance/assets/hass.json"
ENV_FILE = "/etc/glance-hass.env"
GROUP_DOMAINS = ("light", "switch", "group")


def read_env(path):
    vals = {}
    try:
        with open(path) as f:
            for line in f:
                line = line.strip()
                if line and not line.startswith("#") and "=" in line:
                    key, _, value = line.partition("=")
                    vals[key] = value
    except OSError:
        pass
    return vals


_env = read_env(ENV_FILE)
HASS_URL = (_env.get("HASS_URL") or os.environ.get("HASS_URL")
            or "http://localhost:8123").rstrip("/")
TOKEN = (_env.get("HASS_TOKEN") or os.environ.get("HASS_TOKEN", "")).strip()


def write(data):
    os.makedirs(os.path.dirname(OUT), exist_ok=True)
    tmp = OUT + ".tmp"
    with open(tmp, "w") as f:
        json.dump(data, f)
    os.replace(tmp, OUT)


if not TOKEN:
    write({"configured": False,
           "reason": "No Home Assistant token yet — create a long-lived "
                     "access token in HA (profile → Security) and save it "
                     "on the dashboard's Admin page."})
    sys.exit(0)


def api(path):
    req = urllib.request.Request(HASS_URL + path)
    req.add_header("Authorization", "Bearer " + TOKEN)
    with urllib.request.urlopen(req, timeout=10) as resp:
        return json.load(resp)


try:
    states = api("/api/states")
except Exception as e:
    write({"configured": False, "reason": f"Home Assistant unreachable: {e}"})
    sys.exit(0)

try:
    version = api("/api/config").get("version") or "?"
except Exception:
    version = "?"

# Power sensors (keyed by object id for the member-prefix match below),
# plus climate readings and low batteries for the page's side widgets.
sensors = {}
climate = []
low_batteries = []
for s in states:
    domain, _, object_id = s["entity_id"].partition(".")
    attrs = s.get("attributes") or {}
    if domain != "sensor":
        continue
    device_class = attrs.get("device_class")
    try:
        value = float(s["state"])
    except (TypeError, ValueError):
        continue  # unavailable/unknown
    name = attrs.get("friendly_name") or object_id
    unit = attrs.get("unit_of_measurement")
    if device_class == "power":
        watts = value * 1000 if unit == "kW" else value
        if unit in ("W", "kW"):
            sensors[object_id] = (name, watts)
    elif device_class in ("temperature", "humidity"):
        climate.append({"name": name, "value": round(value, 1),
                        "unit": unit or ""})
    elif device_class == "battery" and value <= 20:
        low_batteries.append({"name": name, "percent": round(value)})
climate.sort(key=lambda c: c["name"].lower())
low_batteries.sort(key=lambda b: b["percent"])

groups = []
for s in states:
    entity = s["entity_id"]
    domain, _, object_id = entity.partition(".")
    attrs = s.get("attributes") or {}
    members = attrs.get("entity_id")
    if domain not in GROUP_DOMAINS or not isinstance(members, list) or not members:
        continue
    watts, seen = 0.0, set()
    for m in members:
        m_object = m.partition(".")[2]
        for sid, (_, w) in sensors.items():
            if sid not in seen and sid.startswith(m_object):
                seen.add(sid)
                watts += w
    groups.append({
        "entity": entity,
        "name": attrs.get("friendly_name") or object_id.replace("_", " ").title(),
        "on": s["state"] == "on",
        "unavailable": s["state"] in ("unavailable", "unknown"),
        "members": len(members),
        "has_power": bool(seen),
        "watts": round(watts, 1),
    })
groups.sort(key=lambda g: g["name"].lower())

devices = [{"name": n, "watts": round(w, 1)} for n, w in sensors.values()]
devices.sort(key=lambda d: -d["watts"])

write({
    "configured": True,
    "version": version,
    "entities": len(states),
    "groups": groups,
    "groups_on": sum(1 for g in groups if g["on"]),
    "devices": devices,
    # Simple sum of every power sensor — if HA ever gains an aggregate
    # sensor alongside the per-plug ones, this will double-count.
    "total_watts": round(sum(d["watts"] for d in devices), 1),
    "climate": climate,
    "low_batteries": low_batteries,
    "synced": datetime.now().strftime("%H:%M:%S"),
})
