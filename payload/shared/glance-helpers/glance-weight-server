#!/usr/bin/env python3
"""Tiny HTTP endpoint that logs weigh-ins from the Glance Weight widget.

GET /log?kg=89.4 appends today's weight to the history log, regenerates
the widget JSON, and redirects back to the dashboard. Full history lives
in /var/lib/glance/weight-log.json; the widget only sees the last four
entries plus progress stats.

GET /profile?age=30&height_cm=183&sex=male&activity=1.375 saves the
maintenance-calorie profile (persisted in weight-profile.json) and
regenerates the widget JSON with the new numbers.

GET /hass?entity=light.desk toggles a Home Assistant group from the
Smart Home page's buttons (only entities the glance-hass poller listed
as groups — this port is LAN-open) and re-runs the poller so the
redirect lands on fresh state. Needs HASS_TOKEN from /etc/glance-hass.env
(via the systemd unit).

GET /finance?salary=30000&bills=...&needs_pct=50&wants_pct=25
&savings_pct=25 saves the budget-plan constants for the Finances page's
Budget Settings widget to finance-constants.json. Monthly take-home is
estimated from the annual salary (UK PAYE tax + NI) and written as the
"income" and "budget" fields glance-bank already reads (overriding the
/etc/glance-bank.env defaults); a glance-bank.path unit re-runs it
whenever the file changes, so the dashboard numbers rebuild straight away.
"""
import json
import os
import subprocess
import urllib.error
import urllib.request
from datetime import date, datetime
from http.server import BaseHTTPRequestHandler, HTTPServer
from urllib.parse import parse_qs, urlparse

LOG = "/var/lib/glance/weight-log.json"
PROFILE = "/var/lib/glance/weight-profile.json"
OUT = "/var/lib/glance/assets/weight.json"
PORT = 8081
START_KG = 90.0
GOAL_KG = 75.0
# Defaults until the widget's profile form is saved for the first time.
DEFAULT_PROFILE = {"age": 30, "height_cm": 183, "sex": "male",
                   "activity": 1.375}
ACTIVITY_FACTORS = ("1.2", "1.375", "1.55", "1.725")  # sedentary..very active

# Home Assistant toggle endpoint (Smart Home page). hass.json is written
# by the glance-hass poller and doubles as the allowlist of toggleable
# entities, so this LAN-open port can't be used for arbitrary HA calls.
HASS_URL = os.environ.get("HASS_URL", "http://localhost:8123").rstrip("/")
HASS_TOKEN = os.environ.get("HASS_TOKEN", "").strip()
HASS_JSON = "/var/lib/glance/assets/hass.json"

# Budget-plan constants for the Finances page. Lives under assets/ so the
# Budget Settings widget can read it back for display and form prefill.
FINANCE = "/var/lib/glance/assets/finance-constants.json"
DEFAULT_FINANCE = {"salary": 30000.0, "bills": 1000.0,
                   "needs_pct": 50, "wants_pct": 25, "savings_pct": 25}

# UK PAYE income tax + employee Class 1 NI for the salary -> take-home
# estimate (2026/27 rates; thresholds frozen for years yet). Assumes no
# pension contributions, student loan or other payslip deductions. Tax
# bands apply to taxable income, i.e. after the personal allowance —
# which tapers away £1 per £2 earned above £100k.
PERSONAL_ALLOWANCE = 12570.0
BASIC_BAND = 37700.0     # 20% on taxable income up to this
HIGHER_LIMIT = 125140.0  # 40% up to this, 45% above
NI_LOWER, NI_UPPER = 12570.0, 50270.0
NI_MAIN_RATE, NI_UPPER_RATE = 0.08, 0.02


def uk_take_home(salary):
    allowance = PERSONAL_ALLOWANCE
    if salary > 100_000:
        allowance = max(0.0, allowance - (salary - 100_000) / 2)
    taxable = max(0.0, salary - allowance)
    tax = 0.20 * min(taxable, BASIC_BAND)
    tax += 0.40 * max(0.0, min(taxable, HIGHER_LIMIT) - BASIC_BAND)
    tax += 0.45 * max(0.0, taxable - HIGHER_LIMIT)
    ni = (NI_MAIN_RATE * max(0.0, min(salary, NI_UPPER) - NI_LOWER)
          + NI_UPPER_RATE * max(0.0, salary - NI_UPPER))
    return salary - tax - ni


def build_finance(fin):
    """Derive the monthly figures from salary + bills + split. Take-home
    is written as both "income" and "budget" — the fields glance-bank and
    the Home page widget already read — so spending is measured against
    what actually lands in the bank each month."""
    take_home = round(uk_take_home(fin["salary"]) / 12, 2)
    return {**fin, "income": take_home, "budget": take_home,
            "tax_monthly": round(fin["salary"] / 12 - take_home, 2),
            "needs_amt": round(take_home * fin["needs_pct"] / 100, 2),
            "food_amt": round(max(
                0.0, take_home * fin["needs_pct"] / 100 - fin["bills"]), 2),
            "wants_amt": round(take_home * fin["wants_pct"] / 100, 2),
            "savings_amt": round(take_home * fin["savings_pct"] / 100, 2),
            "configured": True}


def ensure_finance():
    """Create finance-constants.json, or migrate an older version: any
    saved inputs survive and the derived fields are (re)built, so new
    derived fields appear without waiting for the next form save."""
    cur = {}
    if os.path.exists(FINANCE):
        with open(FINANCE) as f:
            cur = json.load(f)
        if "salary" in cur and "food_amt" in cur:
            return
    fin = dict(DEFAULT_FINANCE)
    for k in DEFAULT_FINANCE:
        if k in cur:
            fin[k] = cur[k]
    write_json(FINANCE, build_finance(fin))


def maintenance_kcal(kg, prof):
    # Mifflin-St Jeor BMR scaled by the activity factor.
    bmr = (10 * kg + 6.25 * prof["height_cm"] - 5 * prof["age"]
           + (5 if prof["sex"] == "male" else -161))
    return int(round(bmr * float(prof["activity"]) / 10) * 10)


def load_profile():
    prof = dict(DEFAULT_PROFILE)
    if os.path.exists(PROFILE):
        with open(PROFILE) as f:
            prof.update(json.load(f))
    return prof


def pretty(iso):
    return datetime.strptime(iso, "%Y-%m-%d").strftime("%-d %b %Y")


def load_log():
    if os.path.exists(LOG):
        with open(LOG) as f:
            return json.load(f)
    return []


def write_json(path, data):
    os.makedirs(os.path.dirname(path), exist_ok=True)
    tmp = path + ".tmp"
    with open(tmp, "w") as f:
        json.dump(data, f)
    os.replace(tmp, path)


def regenerate(entries):
    prof = load_profile()
    entries.sort(key=lambda e: e["date"])
    if entries:
        current = entries[-1]
        data = {
            "configured": True,
            "current": current["kg"],
            "current_date": pretty(current["date"]),
            "previous": [{"kg": e["kg"], "date": pretty(e["date"])}
                         for e in entries[-4:-1]],
            "lost": round(START_KG - current["kg"], 1),
            "to_go": round(current["kg"] - GOAL_KG, 1),
            "percent": max(0, min(100, round(
                (START_KG - current["kg"]) / (START_KG - GOAL_KG) * 100))),
            "maint": maintenance_kcal(current["kg"], prof),
        }
    else:
        data = {"configured": False}
    # Echoed back so the widget's profile form shows the saved values.
    data.update({
        "profile_age": prof["age"],
        "profile_height": prof["height_cm"],
        "profile_sex": prof["sex"],
        "profile_activity": str(prof["activity"]),
    })
    write_json(OUT, data)


class Handler(BaseHTTPRequestHandler):
    def do_GET(self):
        url = urlparse(self.path)
        query = parse_qs(url.query)
        if url.path == "/log":
            try:
                kg = round(float(query["kg"][0]), 1)
                if not 30 <= kg <= 300:
                    raise ValueError
            except (KeyError, ValueError, IndexError):
                self.send_error(400, "kg must be a number between 30 and 300")
                return
            today = date.today().isoformat()
            entries = [e for e in load_log() if e["date"] != today]
            entries.append({"date": today, "kg": kg})
            write_json(LOG, sorted(entries, key=lambda e: e["date"]))
            regenerate(entries)
        elif url.path == "/hass":
            entity = query.get("entity", [""])[0]
            try:
                with open(HASS_JSON) as f:
                    allowed = {g["entity"]
                               for g in json.load(f).get("groups", [])}
            except (OSError, ValueError, TypeError):
                allowed = set()
            if not HASS_TOKEN or entity not in allowed:
                self.send_error(400, "unknown group entity")
                return
            req = urllib.request.Request(
                HASS_URL + "/api/services/homeassistant/toggle",
                data=json.dumps({"entity_id": entity}).encode(),
                headers={"Authorization": "Bearer " + HASS_TOKEN,
                         "Content-Type": "application/json"})
            try:
                with urllib.request.urlopen(req, timeout=10) as resp:
                    resp.read()
            except (urllib.error.URLError, OSError):
                self.send_error(502, "Home Assistant not reachable")
                return
            # Refresh hass.json now so the redirect shows the new state;
            # the toggle already happened, so never fail the request here.
            try:
                subprocess.run(["/usr/local/bin/glance-hass"], check=False)
            except OSError:
                pass
        elif url.path == "/finance":
            try:
                fin = {
                    "salary": round(float(query["salary"][0]), 2),
                    "bills": round(float(query["bills"][0]), 2),
                    "needs_pct": int(query["needs_pct"][0]),
                    "wants_pct": int(query["wants_pct"][0]),
                    "savings_pct": int(query["savings_pct"][0]),
                }
                pcts = (fin["needs_pct"], fin["wants_pct"],
                        fin["savings_pct"])
                if not (0 <= fin["salary"] <= 10_000_000
                        and 0 <= fin["bills"] <= 1_000_000
                        and all(0 <= p <= 100 for p in pcts)
                        and sum(pcts) == 100):
                    raise ValueError
            except (KeyError, ValueError, IndexError):
                self.send_error(
                    400, "bad finance values (split must sum to 100)")
                return
            write_json(FINANCE, build_finance(fin))
        elif url.path == "/profile":
            try:
                prof = {
                    "age": int(query["age"][0]),
                    "height_cm": int(query["height_cm"][0]),
                    "sex": query["sex"][0],
                    "activity": float(query["activity"][0]),
                }
                if not (10 <= prof["age"] <= 120
                        and 100 <= prof["height_cm"] <= 250
                        and prof["sex"] in ("male", "female")
                        and query["activity"][0] in ACTIVITY_FACTORS):
                    raise ValueError
            except (KeyError, ValueError, IndexError):
                self.send_error(400, "bad profile values")
                return
            write_json(PROFILE, prof)
            regenerate(load_log())
        else:
            self.send_error(404)
            return
        # Cross-origin form posts (dashboard :8080 -> here :8081) get a
        # path-stripped Referer, so forms pass the return URL explicitly.
        back = query.get("back", [""])[0]
        if not back.startswith(("http://", "https://")):
            back = self.headers.get("Referer") or "/"
        self.send_response(303)
        self.send_header("Location", back)
        self.end_headers()

    def log_message(self, *args):
        pass


if __name__ == "__main__":
    regenerate(load_log())  # ensure weight.json exists before first log
    ensure_finance()
    HTTPServer(("", PORT), Handler).serve_forever()
