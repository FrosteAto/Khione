#!/usr/bin/env python3
"""Fetch bank activity from GoCardless Bank Account Data and write JSON for
the Glance dashboard: budget.json (Home page's Monthly Spending widget) and
finance.json (the Finances page).

One transactions call per run — GoCardless institutions typically allow ~4
per day and the 6h timer is already at that cap, so everything on both pages
must come from this single fetch. Booked transactions are merged into
/var/lib/glance/bank-history.jsonl so month-vs-month comparisons and
recurring-payment detection can outlive the ~90-day window the API returns.

Credentials come from /etc/glance-bank.env (via the systemd unit); run
glance-bank-setup to create them and link a bank account.
"""
import calendar
import json
import math
import os
import re
import statistics
import sys
import urllib.error
import urllib.request
from collections import Counter, defaultdict
from datetime import date, datetime, timedelta, timezone

OUT_BUDGET = "/var/lib/glance/assets/budget.json"
OUT_FINANCE = "/var/lib/glance/assets/finance.json"
HISTORY = "/var/lib/glance/bank-history.jsonl"
API = "https://bankaccountdata.gocardless.com/api/v2"
FETCH_DAYS = 90  # most banks' full access window; still a single API call


def write(path, data):
    os.makedirs(os.path.dirname(path), exist_ok=True)
    tmp = path + ".tmp"
    with open(tmp, "w") as f:
        json.dump(data, f)
    os.replace(tmp, path)


def api(path, token=None, payload=None):
    req = urllib.request.Request(API + path)
    req.add_header("Accept", "application/json")
    if token:
        req.add_header("Authorization", "Bearer " + token)
    if payload is not None:
        req.add_header("Content-Type", "application/json")
        req.data = json.dumps(payload).encode()
    with urllib.request.urlopen(req, timeout=30) as resp:
        return json.load(resp)


# Bank-added noise around the actual merchant name.
DROP_PREFIXES = (
    "CARD PAYMENT TO ", "DIRECT DEBIT PAYMENT TO ", "DIRECT DEBIT ",
    "STANDING ORDER TO ", "BILL PAYMENT TO ", "PAYMENT TO ", "TRANSFER TO ",
)
DROP_WORDS = {"LTD", "LIMITED", "PLC", "REF"}


def display_name(t, amount):
    arr = t.get("remittanceInformationUnstructuredArray") or []
    for cand in (
        t.get("creditorName") if amount < 0 else t.get("debtorName"),
        t.get("remittanceInformationUnstructured"),
        " ".join(arr),
        t.get("creditorName") or t.get("debtorName"),
    ):
        if cand and cand.strip():
            s = re.sub(r"\s+", " ", cand).strip()
            for p in DROP_PREFIXES:
                if s.upper().startswith(p):
                    s = s[len(p):]
            s = re.sub(r"\s+REF\s+\S+$", "", s, flags=re.I)
            return s[:48] or "Unknown"
    return "Unknown"


def merchant_key(name):
    """Group 'TESCO STORES 2445' and 'Tesco Stores 6612' as one merchant."""
    s = name.upper()
    for p in DROP_PREFIXES:
        if s.startswith(p):
            s = s[len(p):]
    s = re.sub(r"[^A-Z ]+", " ", s)
    words = [w for w in s.split() if w not in DROP_WORDS]
    return " ".join(words[:3]) or name.upper()


def group_label(records):
    """Nicest display name for a merchant group: the most common raw one."""
    return Counter(r["name"] for r in records).most_common(1)[0][0]


secret_id = os.environ.get("GC_SECRET_ID")
secret_key = os.environ.get("GC_SECRET_KEY")
account_id = os.environ.get("GC_ACCOUNT_ID")
budget = float(os.environ.get("BUDGET_MONTHLY", "1790"))

# Budget plan (50/25/25 needs/wants/savings) derived from expected income.
income_expected = float(os.environ.get("INCOME_MONTHLY", "2387.42"))
bills_planned = float(os.environ.get("BILLS_MONTHLY", "1015.48"))
needs_max = income_expected * 0.50
wants_max = income_expected * 0.25
savings_max = income_expected * 0.25
food_allowance = max(0.0, needs_max - bills_planned)

if not (secret_id and secret_key and account_id):
    write(OUT_BUDGET, {"configured": False})
    write(OUT_FINANCE, {"configured": False})
    sys.exit(0)

# On any API failure below the script exits non-zero and the previous JSON
# files are left in place, so the widgets keep showing stale-but-real
# numbers instead of an error.
token = api("/token/new/", payload={"secret_id": secret_id, "secret_key": secret_key})["access"]

today = date.today()
month_start = today.replace(day=1)
fetch_from = today - timedelta(days=FETCH_DAYS)
try:
    data = api(f"/accounts/{account_id}/transactions/?date_from={fetch_from.isoformat()}", token=token)
except urllib.error.HTTPError:
    # Some institutions cap how far back a single request may reach.
    data = api(f"/accounts/{account_id}/transactions/?date_from={month_start.isoformat()}", token=token)

# ---- merge this fetch into the local history cache -------------------------
history = {}
try:
    with open(HISTORY) as f:
        for line in f:
            line = line.strip()
            if line:
                r = json.loads(line)
                history[r["id"]] = r
except FileNotFoundError:
    pass

for t in data["transactions"]["booked"]:
    amount = float(t["transactionAmount"]["amount"])
    booked_on = t.get("bookingDate") or t.get("valueDate")
    if not booked_on:
        continue
    name = display_name(t, amount)
    key = (t.get("transactionId") or t.get("internalTransactionId")
           or f"{booked_on}|{amount:.2f}|{name}")
    history[key] = {"id": key, "date": booked_on, "amount": round(amount, 2), "name": name}

records = sorted(history.values(), key=lambda r: r["date"])
tmp = HISTORY + ".tmp"
with open(tmp, "w") as f:
    for r in records:
        f.write(json.dumps(r) + "\n")
os.replace(tmp, HISTORY)

# ---- budget.json (Home page widget, fields unchanged) ----------------------
month_records = [r for r in records if r["date"] >= month_start.isoformat()]
spent = sum(-r["amount"] for r in month_records if r["amount"] < 0)
income = sum(r["amount"] for r in month_records if r["amount"] > 0)

days_in_month = calendar.monthrange(today.year, today.month)[1]
days_elapsed = today.day
days_left = days_in_month - today.day + 1  # including today
projected = spent / days_elapsed * days_in_month
left = max(0.0, budget - spent)
updated = datetime.now(timezone.utc).strftime("%d %b %H:%M UTC")

write(OUT_BUDGET, {
    "configured": True,
    "month": month_start.strftime("%B"),
    "spent": round(spent, 2),
    "budget": budget,
    "percent": min(100, round(spent / budget * 100)) if budget else 0,
    "income": round(income, 2),
    "income_expected": round(income_expected, 2),
    "income_percent": min(100, round(income / income_expected * 100)) if income_expected else 0,
    "projected": round(projected, 2),
    "left": round(left, 2),
    "per_day_left": round(left / days_left, 2),
    "per_day_spent": round(spent / days_elapsed, 2),
    "days_left": days_left,
    "bills": round(bills_planned, 2),
    "food": round(food_allowance, 2),
    "wants": round(wants_max, 2),
    "savings": round(savings_max, 2),
    "updated": updated,
})

# ---- finance.json (Finances page) -------------------------------------------


def parse(d):
    return date.fromisoformat(d)


# Top merchants this month, bar scaled against the biggest one.
by_merchant = defaultdict(list)
for r in month_records:
    if r["amount"] < 0:
        by_merchant[merchant_key(r["name"])].append(r)
merchants = [{
    "name": group_label(rs),
    "total": round(sum(-r["amount"] for r in rs), 2),
    "count": len(rs),
} for rs in by_merchant.values()]
merchants.sort(key=lambda m: -m["total"])
merchants = merchants[:8]
top_total = merchants[0]["total"] if merchants else 0
for m in merchants:
    m["percent"] = round(m["total"] / top_total * 100) if top_total else 0
    m["share"] = round(m["total"] / spent * 100) if spent else 0

recent = [{
    "date": parse(r["date"]).strftime("%d %b"),
    "name": r["name"],
    "amount": f"{abs(r['amount']):,.2f}",
    "in": r["amount"] > 0,
} for r in sorted(records, key=lambda r: r["date"], reverse=True)[:12]]

biggest = [{
    "date": parse(r["date"]).strftime("%d %b"),
    "name": r["name"],
    "amount": round(-r["amount"], 2),
} for r in sorted(month_records, key=lambda r: r["amount"])[:5] if r["amount"] < 0]

# Spend per day over the last 30 days. Bars use a square-root scale so
# one rent payment doesn't flatten every ordinary day into a sliver.
per_day = defaultdict(float)
for r in records:
    if r["amount"] < 0:
        per_day[r["date"]] += -r["amount"]
daily = []
for i in range(29, -1, -1):
    d = today - timedelta(days=i)
    daily.append({"date": d.strftime("%d %b"), "amount": round(per_day.get(d.isoformat(), 0.0), 2)})
day_max = max((x["amount"] for x in daily), default=0)
for x in daily:
    x["percent"] = round(math.sqrt(x["amount"] / day_max) * 100) if day_max else 0

# Same-point-last-month comparison (clamped for short months).
last_month_end = month_start - timedelta(days=1)
last_month_start = last_month_end.replace(day=1)
lm_out = [r for r in records
          if last_month_start.isoformat() <= r["date"] <= last_month_end.isoformat()
          and r["amount"] < 0]
cutoff_day = min(today.day, last_month_end.day)
lm_out_to_date = sum(-r["amount"] for r in lm_out if parse(r["date"]).day <= cutoff_day)
last_month = {
    "name": last_month_start.strftime("%B"),
    "available": lm_out_to_date > 0,
    "out_total": round(sum(-r["amount"] for r in lm_out), 2),
    "out_to_date": round(lm_out_to_date, 2),
}
if lm_out_to_date > 0:
    delta = (spent - lm_out_to_date) / lm_out_to_date * 100
    last_month["delta_percent"] = round(abs(delta))
    last_month["up"] = delta > 0

# Recurring payments: same merchant, steady amount, roughly monthly cadence.
# Only looks at the last 120 days so long-dead subscriptions age out.
recurring = []
recent_cutoff = (today - timedelta(days=120)).isoformat()
by_merchant_all = defaultdict(list)
for r in records:
    if r["amount"] < 0 and r["date"] >= recent_cutoff:
        by_merchant_all[merchant_key(r["name"])].append(r)
for rs in by_merchant_all.values():
    rs.sort(key=lambda r: r["date"])
    dates = sorted({r["date"] for r in rs})
    if len(dates) < 2 or len({d[:7] for d in dates}) < 2:
        continue
    amounts = [-r["amount"] for r in rs]
    if max(amounts) - min(amounts) > max(2.0, 0.2 * statistics.median(amounts)):
        continue
    gaps = [(parse(b) - parse(a)).days for a, b in zip(dates, dates[1:])]
    if not 24 <= statistics.median(gaps) <= 38:
        continue
    recurring.append({
        "name": group_label(rs),
        "amount": round(-rs[-1]["amount"], 2),
        "last": parse(rs[-1]["date"]).strftime("%d %b"),
    })
recurring.sort(key=lambda x: -x["amount"])
recurring = recurring[:10]

net = income - spent
write(OUT_FINANCE, {
    "configured": True,
    "month": month_start.strftime("%B"),
    "in": round(income, 2),
    "out": round(spent, 2),
    "net": round(abs(net), 2),
    "net_positive": net >= 0,
    "kept_percent": max(0, round(net / income * 100)) if income else 0,
    "merchants": merchants,
    "recent": recent,
    "biggest": biggest,
    "daily": daily,
    "last_month": last_month,
    "recurring": recurring,
    "recurring_total": round(sum(x["amount"] for x in recurring), 2),
    "updated": updated,
})
